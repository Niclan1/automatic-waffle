{
  "expo": {
    "name": "Volkspele",
    "slug": "volkspele",
    "version": "0.1.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#174e43",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "android": {
      "package": "za.co.niclan.volkspele",
      "versionCode": 2,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#174e43"
      }
    },
    "ios": {
      "bundleIdentifier": "za.co.niclan.volkspele",
      "buildNumber": "2",
      "supportsTablet": true
    },
    "plugins": [
      "expo-file-system",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ]
  }
}
