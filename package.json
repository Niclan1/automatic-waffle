{
  "name": "volkspele",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "wasm": "wasm-pack build crates/catalog-core --target web --release",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "build:all": "npm run wasm && npm run build",
    "check": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "content": "node scripts/build-content.mjs",
    "pages": "npm run build && npm run content",
    "desktop": "npm run build && node scripts/prepare-desktop.mjs && electron .",
    "desktop:package": "npm run build && node scripts/prepare-desktop.mjs && electron-builder --publish never",
    "mobile": "npm run start --workspace apps/mobile",
    "check:mobile": "npm run check --workspace apps/mobile",
    "test:mobile": "jest --runInBand",
    "test:browser": "playwright test",
    "test:offline": "playwright test --config playwright.production.config.ts",
    "postinstall": "node scripts/build-notation.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "opensheetmusicdisplay": "^2.2.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "tailwindcss": "^4.0.0",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "vite": "^6.0.0",
    "@types/jest": "29.5.14",
    "react-native": "0.86.3"
  },
  "build": {
    "appId": "za.co.niclan.volkspele",
    "productName": "Volkspele",
    "artifactName": "Volkspele-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "app": "desktop-stage",
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Niclan1"
    }
  }
}
